# ==============================================================================
# Trading Journal - Environment Variables Configuration
# ==============================================================================

# Port configuration (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 1. Firebase Configuration (Optional - for Auth & Cloud Firestore sync)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Cloudinary Configuration (Optional - for permanent cloud screenshot hosting)
# If not provided, screenshots are stored in the local ./uploads directory
# ------------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 3. Database Persistence (Optional - MongoDB Atlas or local URI)
# If not provided, data automatically persists in local data_store.json file
# ------------------------------------------------------------------------------
MONGODB_URI=

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Key (Optional - for AI Trade Reviews & Market Psychology)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
