# ==============================================================================
# Pip Track (Trading Journal) - Environment Variables Configuration Template
# ==============================================================================
# COPY THIS FILE TO `.env.local` AND POPULATE WITH YOUR ACTUAL CONFIGURATION.
# NEVER COMMIT `.env.local` OR REAL SECRETS TO VERSION CONTROL.

# Application Server Port (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 1. Cloudinary Configuration (Optional - for remote screenshot hosting)
# If left empty, screenshots are saved to local server storage (/uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ------------------------------------------------------------------------------
# 2. Database Persistence (Optional - MongoDB Atlas or local URI)
# If left empty, journal data automatically persists in local data_store.json
# ------------------------------------------------------------------------------
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. Google Gemini AI (Optional - for server-side AI Trade Insights & Review)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Firebase Authentication & Firestore (Optional - for multi-device sync)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
